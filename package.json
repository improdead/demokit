{
  "name": "@dekai/demokit",
  "version": "0.2.0",
  "description": "Agent-native demo videos in one command: plan from the codebase, record a deterministic flow in headless Chromium, render it the way Cap does (spring zoom on clicks, real cursor shapes, wallpaper, squircle, shadow), fast-forward dead air, and verify the feature actually worked. No Docker.",
  "bin": {
    "demokit": "bin/demokit"
  },
  "files": [
    "bin/demokit",
    "src/",
    "skill/",
    "flows/example.json",
    "flows/seeded-example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "playwright-core": "^1.62.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "scripts": {
    "postinstall": "node -e \"console.log('demokit ready. Run: demokit local <flow.json> <out.mp4>')\""
  },
  "keywords": [
    "demo",
    "video",
    "screen-recording",
    "playwright",
    "ffmpeg",
    "cap",
    "agent",
    "claude-code",
    "skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/improdead/demokit.git"
  },
  "license": "MIT"
}
