{
  "name": "@dekai/demokit",
  "version": "0.3.1",
  "description": "Record repeatable local product demos with cursor effects, zoom, pacing, and feature-verification evidence. CLI plus agent skill.",
  "bin": {
    "demokit": "bin/demokit"
  },
  "files": [
    "bin/demokit",
    "src/",
    "skill/",
    "examples/quickstart/",
    "examples/findings-app/",
    "fixtures/",
    "flows/seeded-example.json",
    "docs/",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "playwright-core": "^1.62.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "keywords": [
    "demo",
    "video",
    "screen-recording",
    "playwright",
    "ffmpeg",
    "cap",
    "agent",
    "claude-code",
    "skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/improdead/demokit.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/improdead/demokit#readme",
  "bugs": {
    "url": "https://github.com/improdead/demokit/issues"
  }
}
