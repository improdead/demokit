#!/usr/bin/env bash
# demokit — flow JSON in, demo MP4 out.
#
#   bin/demokit login <url>                              # sign in once; recordings reuse it
#   bin/demokit local flows/x.json out.mp4               # DEFAULT: headless Chromium, no Docker
#   bin/demokit probe <url>                              # inspect with local Chromium
#   bin/demokit box flows/x.json out.mp4                 # real cursor, in a container
#   bin/demokit term "pytest -q" out.mp4                 # a terminal, drawn offscreen
#   bin/demokit termreal spec.json out.mp4               # a REAL recording of Terminal.app
#   bin/demokit screen out.mp4 --app "Google Chrome" --seconds 30   # real cursor
#   bin/demokit review <shotDir> out.mp4 --fix           # measure it, then improve it
#   bin/demokit wallpapers all                           # 4K grounds, local + fetched
#   bin/demokit edit <shotDir>                           # why the camera moves, as a file
#   bin/demokit raw <shotDir>                            # the take, with no edit applied
#   bin/demokit still <shotDir>                          # where nothing is happening
#   bin/demokit verify <shotDir> out.mp4                 # did the FEATURE work
#   bin/demokit critic <shotDir> out.mp4                 # frames to WATCH + invariants
#   bin/demokit --session <id> <flow.json> <out.mp4>     # record via real Chrome (auth)
#   bin/demokit flows/example.json out.mp4 [--level 1.35 --inset 0.84 ...]
#   bin/demokit --render-only .demokit/shot-example out.mp4   # re-render, no recapture
#
# Paths supplied by the user resolve from their calling directory.
set -euo pipefail
# Under `npm install -g` this script is a symlink in the global bin dir, so
# dirname "$0" is the wrong place. Resolve the link, keep the caller's cwd for
# THEIR paths, and keep work files in their directory rather than inside the
# package.
CALLER_PWD="$PWD"
command -v node >/dev/null || { echo "demokit: Node.js 20+ is required" >&2; exit 1; }
SELF="$(node -e 'console.log(require("fs").realpathSync(process.argv[1]))' "$0")"
cd "$(dirname "$SELF")/.."
abs() { case "$1" in /*) printf '%s\n' "$1";; *) printf '%s\n' "$CALLER_PWD/$1";; esac; }
export DEMOKIT_CALLER="$CALLER_PWD"
case "${1:---help}" in --help|-h|help|--version|-v|init|skill) cd "$CALLER_PWD"; exec node "$(dirname "$SELF")/../src/setup.mjs" "$@";; esac
export DEMOKIT_WORK="$(abs "${DEMOKIT_WORK:-$CALLER_PWD/.demokit}")"
[ -n "${DEMOKIT_COOKIES:-}" ] && export DEMOKIT_COOKIES="$(abs "$DEMOKIT_COOKIES")"
[ -n "${DEMOKIT_AUTH:-}" ] && export DEMOKIT_AUTH="$(abs "$DEMOKIT_AUTH")"
mkdir -p "$DEMOKIT_WORK"
# Generated captures must stay untracked even in a new user repository.
[ -e "$DEMOKIT_WORK/.gitignore" ] || printf '*\n' > "$DEMOKIT_WORK/.gitignore"
export PATH="$HOME/.local/bin:$PATH"

die() { echo "demokit: $*" >&2; exit 1; }

ROOT="$(pwd)"
# ffmpeg: the package ships a static build; a system one is used if present.
# Resolve dependencies the way Node does, from the package root. When npm
# installs this package its dependencies are HOISTED to the parent node_modules,
# so looking only inside this directory finds nothing. `require.resolve` walks up.
resolve_dep() { node -e "try{console.log(require.resolve(process.argv[1],{paths:[process.argv[2]]}))}catch(e){}" "$1" "$ROOT" 2>/dev/null; }
if ! command -v ffmpeg >/dev/null; then
  FF="$(resolve_dep ffmpeg-static)"; [ -n "$FF" ] && export PATH="$(dirname "$(node -e "console.log(require(process.argv[1]))" "$FF")"):$PATH"
fi
if ! command -v ffprobe >/dev/null; then
  FP="$(resolve_dep ffprobe-static)"; [ -n "$FP" ] && export PATH="$(dirname "$(node -e "console.log(require(process.argv[1]).path)" "$FP")"):$PATH"
fi
if [ -z "${DEMOKIT_PW:-}" ]; then
  PWC="$(resolve_dep playwright-core/package.json)"; [ -n "$PWC" ] && export DEMOKIT_PW="$(dirname "$PWC")"
  [ -z "${DEMOKIT_PW:-}" ] && [ -d "$ROOT/.tools/node_modules/playwright-core" ] && export DEMOKIT_PW="$ROOT/.tools/node_modules/playwright-core"
fi
command -v ffmpeg >/dev/null && command -v ffprobe >/dev/null || die "ffmpeg/ffprobe not found. Install a system ffmpeg/ffprobe or allow ffmpeg-static install scripts and reinstall @dekai/demokit"
# The renderer is Python (Pillow + numpy). Provision it rather than instructing.
#
# Telling someone to run a second command is a second chance to bounce off. A
# venv with both takes ~4s and 43MB, once, cached outside any project - so the
# first run just does it and says so. A system python that already has them is
# used as-is and nothing is created.
DEMOKIT_CACHE="${DEMOKIT_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/demokit}"
export DEMOKIT_PY=""
if python3 -c "import PIL, numpy" 2>/dev/null; then
  export DEMOKIT_PY="python3"
elif [ -x "$DEMOKIT_CACHE/venv/bin/python" ] && "$DEMOKIT_CACHE/venv/bin/python" -c "import PIL, numpy" 2>/dev/null; then
  export DEMOKIT_PY="$DEMOKIT_CACHE/venv/bin/python"
else
  command -v python3 >/dev/null || die "python3 3.8+ is required (the renderer is Python). Install it from python.org or: brew install python"
  echo "demokit: setting up the Python renderer (first run only, ~4s)..." >&2
  mkdir -p "$DEMOKIT_CACHE"
  rm -rf "$DEMOKIT_CACHE/venv"
  if command -v uv >/dev/null; then
    uv venv --quiet "$DEMOKIT_CACHE/venv" >/dev/null 2>&1 \
      && VIRTUAL_ENV="$DEMOKIT_CACHE/venv" uv pip install --quiet pillow numpy >/dev/null 2>&1
  else
    python3 -m venv "$DEMOKIT_CACHE/venv" >/dev/null 2>&1 \
      && "$DEMOKIT_CACHE/venv/bin/pip" install --quiet --disable-pip-version-check pillow numpy >/dev/null 2>&1
  fi
  if [ -x "$DEMOKIT_CACHE/venv/bin/python" ] && "$DEMOKIT_CACHE/venv/bin/python" -c "import PIL, numpy" 2>/dev/null; then
    export DEMOKIT_PY="$DEMOKIT_CACHE/venv/bin/python"
    echo "demokit: renderer ready ($DEMOKIT_CACHE/venv)" >&2
  else
    die "could not set up the Python renderer. Install the two packages yourself and re-run: python3 -m pip install pillow numpy"
  fi
fi
# Playwriter is only needed for the explicit --session path.
need_playwriter() { command -v playwriter >/dev/null || die "this path records through your own Chrome and needs playwriter (npm i -g playwriter). The default path does not - run: bin/demokit local <flow.json> <out.mp4>"; }

# record.js/probe.js use top-level await and run inside playwriter's sandbox, so
# `node --check` (CommonJS) rejects them. Validate them as async bodies instead.
node -e '
const fs=require("fs"), AsyncFn=Object.getPrototypeOf(async function(){}).constructor;
for (const f of ["src/record.js","src/probe.js"]) {
  try { new AsyncFn("context","state","getCDPSession", fs.readFileSync(f,"utf8")); }
  catch (e) { console.error("demokit: syntax error in "+f+": "+e.message); process.exit(1); }
}' || exit 1

SESSION_OVERRIDE=""
if [ "${1:-}" = "--session" ]; then shift; SESSION_OVERRIDE="${1:?--session needs an id}"; shift; fi

ensure_browser() {
  # Probe an actual launch: the headless-shell path differs from executablePath().
  if ! node -e 'const {chromium}=require(process.argv[1]); chromium.launch({headless:true}).then(b=>b.close()).catch(()=>process.exit(1))' "$DEMOKIT_PW" 2>/dev/null; then
    echo "demokit: installing Chromium headless shell (first run may download ~200 MB)..."
    node "$DEMOKIT_PW/cli.js" install chromium-headless-shell || die "Chromium setup failed; on Linux also install Playwright system dependencies (see README)."
  fi
}

if [ "${1:-}" = "probe" ]; then
  shift; URL="${1:?usage: demokit probe <url>}"
  if [ -n "$SESSION_OVERRIDE" ]; then
    need_playwriter
    exec node src/playwriter-run.mjs "$SESSION_OVERRIDE" probe "$URL" "$DEMOKIT_WORK/probe.json"
  fi
  ensure_browser
  exec node src/probe-local.mjs "$URL" "$DEMOKIT_WORK/probe.json"
fi

# Offscreen terminal recording: runs the command in a pty and paints frames
# itself. Never touches the display, so it works in the background.
if [ "${1:-}" = "term" ]; then
  shift; CMD="${1:?usage: demokit term \"<shell command>\" <out.mp4> [--cols N --rows N --title T] [render flags]}"; shift
  OUT="$(abs "${1:?usage: demokit term \"<cmd>\" <out.mp4>}")"; shift
  SHOT="$DEMOKIT_WORK/shot-term"
  TERMARGS=(); RENDARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --cols|--rows|--fps|--width|--title|--max-seconds) TERMARGS+=("$1" "$2"); shift 2;;
      *) RENDARGS+=("$1"); shift;;
    esac
  done
  "$DEMOKIT_PY" src/term.py "$SHOT" --cmd "$CMD" "${TERMARGS[@]+"${TERMARGS[@]}"}"
  exec node src/demo.mjs "$SHOT" "$OUT" "${RENDARGS[@]+"${RENDARGS[@]}"}"
fi

# A REAL screen recording of the real Terminal.app, driven by keystrokes.
#
# `term` draws the window; this films one. It costs the screen - the machine
# cannot be used while it records - and needs Accessibility permission, and in
# exchange every pixel is real, chrome and font rendering included.
if [ "${1:-}" = "termreal" ]; then
  shift; SPEC="$(abs "${1:?usage: demokit termreal <spec.json> <out.mp4> [--seconds N] [render flags]}")"; shift
  OUT="$(abs "${1:?usage: demokit termreal <spec.json> <out.mp4>}")"; shift
  SHOT="$DEMOKIT_WORK/shot-termreal"
  SECS=18; FILL=0.80; RENDARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --seconds) SECS="$2"; shift 2;;
      --fill) FILL="$2"; shift 2;;
      *) RENDARGS+=("$1"); shift;;
    esac
  done
  # One window, targeted by id from here on: staging one window while the
  # keystrokes go to another films a region bigger than the window, with the
  # desktop showing behind it.
  PROF="$("$DEMOKIT_PY" -c 'import json,sys; print(json.load(open(sys.argv[1])).get("prepare",{}).get("profile","Pro"))' "$SPEC")"
  SAVED=".cache/term-profile-$PROF.json"
  mkdir -p .cache
  WID="$(node src/termdrive.mjs "$SPEC" --prepare --save "$SAVED")"
  echo "termreal: driving Terminal window $WID (profile '$PROF' saved to $SAVED)"
  node src/termdrive.mjs --front "$WID"
  sleep 1
  node src/screen.mjs "$SHOT" --app Terminal --fill "$FILL" --seconds "$SECS" --fps 30 \
    --drive "node src/termdrive.mjs $SPEC --window $WID"
  RC=$?
  # Put the user's profile back whatever happened. Recording a video is not a
  # reason to leave someone's terminal a different colour.
  node src/termdrive.mjs --restore "$PROF" "$SAVED" || true
  [ $RC -eq 0 ] || exit $RC
  exec node src/demo.mjs "$SHOT" "$OUT" "${RENDARGS[@]+"${RENDARGS[@]}"}"
fi

# Screen recording of a display or a region, for native apps that are not a
# terminal. Uses macOS screencapture, which already holds the permission.
if [ "${1:-}" = "screen" ]; then
  shift; OUT="$(abs "${1:?usage: demokit screen <out.mp4> --seconds N [--region x,y,w,h] [--display 1]}")"; shift
  SHOT="$DEMOKIT_WORK/shot-screen"
  SCRARGS=(); RENDARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --seconds|--display|--region|--fps|--app|--fill|--drive) SCRARGS+=("$1" "$2"); shift 2;;
      *) RENDARGS+=("$1"); shift;;
    esac
  done
  node src/screen.mjs "$SHOT" "${SCRARGS[@]+"${SCRARGS[@]}"}"
  exec node src/demo.mjs "$SHOT" "$OUT" "${RENDARGS[@]+"${RENDARGS[@]}"}"
fi

# Measure a finished video against the objective checks, and optionally
# re-render until they pass. Framing only - it will not pretend a knob can fix
# a demo of the wrong thing.
# Inspect or regenerate the edit decision list without touching the recording.
if [ "${1:-}" = "edit" ]; then
  shift; SHOT="$(abs "${1:?usage: demokit edit <shotDir> [--print] [--max N] [--gap MS] [--pad F]}")"; shift
  exec node src/edit.mjs "$SHOT" "$@"
fi

# Build the pack an agent watches, and apply what it decided.
# What did we actually record, before any edit had an opinion about it.
if [ "${1:-}" = "raw" ]; then
  shift; SHOT="$(abs "${1:?usage: demokit raw <shotDir> [--n 12]}")"; shift
  exec node src/raw.mjs "$SHOT" "$@"
fi

# Where is nothing happening.
if [ "${1:-}" = "still" ]; then
  shift; SHOT="$(abs "${1:?usage: demokit still <shotDir> [--sec 3]}")"; shift
  exec node src/still.mjs "$SHOT" "$@"
fi

if [ "${1:-}" = "verify" ]; then
  shift; SHOT="$(abs "${1:?usage: demokit verify <shotDir> [out.mp4]}")"; shift
  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then OUT="$(abs "$1")"; shift; exec node src/verify.mjs "$SHOT" "$OUT" "$@"; fi
  exec node src/verify.mjs "$SHOT" "$@"
fi

if [ "${1:-}" = "critic" ]; then
  shift; SHOT="$(abs "${1:?usage: demokit critic <shotDir> <out.mp4> [--apply patch.json]}")"; shift
  OUT="$(abs "${1:?usage: demokit critic <shotDir> <out.mp4>}")"; shift
  exec node src/critic.mjs "$SHOT" "$OUT" "$@"
fi

# Sign in once, in a real window; every recording after that is authenticated.
if [ "${1:-}" = "login" ]; then
  shift; URL="${1:?usage: demokit login <url> [--from-cookies cookies.json]}"; shift
  ARGS=()
  while [ $# -gt 0 ]; do case "$1" in --from-cookies|--out) ARGS+=("$1" "$(abs "$2")"); shift 2;; *) ARGS+=("$1"); shift;; esac; done
  exec node src/login.mjs "$URL" "${ARGS[@]+"${ARGS[@]}"}"
fi

# The default: a headless Chromium demokit launches itself. No Docker, no
# extension, no display. The engine draws the cursor and the window chrome.
if [ "${1:-}" = "local" ] || { [ -z "$SESSION_OVERRIDE" ] && [[ "${1:-}" != --* ]] && [ -f "$(abs "${1:-}")" ]; }; then
  if [ "${1:-}" = "local" ]; then shift; fi
  FLOW="$(abs "${1:?usage: demokit local <flow.json> <out.mp4> [render flags]}")"; shift
  OUT="$(abs "${1:?usage: demokit local <flow.json> <out.mp4>}")"; shift
  SHOT="$DEMOKIT_WORK/shot-$(basename "$FLOW" .json)"
  ensure_browser
  node src/localcap.mjs "$FLOW" "$SHOT" || exit $?
  HOST="$("$DEMOKIT_PY" -c 'import json,sys;from urllib.parse import urlparse;u=urlparse(json.load(open(sys.argv[1]))["url"]);print(u.netloc+u.path)' "$FLOW" 2>/dev/null || echo localhost)"
  TITLE="$("$DEMOKIT_PY" -c 'import json,sys;f=json.load(open(sys.argv[1]));print(f.get("title") or f.get("_title") or "")' "$FLOW" 2>/dev/null)"
  "$DEMOKIT_PY" src/chrome.py "$SHOT" --url "$HOST" ${TITLE:+--title "$TITLE"} || exit $?
  exec node src/demo.mjs "$SHOT" "$OUT" "$@"
fi

# Browser capture inside a container with a real desktop: real X11 cursor, real
# window chrome, and it runs on a display that does not physically exist.
if [ "${1:-}" = "box" ]; then
  shift; FLOW="$(abs "${1:?usage: demokit box <flow.json> <out.mp4> [--size WxH] [render flags]}")"; shift
  OUT="$(abs "${1:?usage: demokit box <flow.json> <out.mp4>}")"; shift
  SHOT="$DEMOKIT_WORK/shot-box"
  BOXARGS=(); RENDARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --size|--fps) BOXARGS+=("$1" "$2"); shift 2;;
      --keep) BOXARGS+=("$1"); shift;;
      *) RENDARGS+=("$1"); shift;;
    esac
  done
  # OrbStack installs its CLI outside the default PATH, and boxflow needs a
  # playwright that ESM import cannot find by name.
  export PATH="$HOME/.orbstack/bin:$PATH"
  [ -n "${DEMOKIT_PW:-}" ] || export DEMOKIT_PW="$(find "$HOME/.npm/_npx" -maxdepth 4 -name playwright-core -type d 2>/dev/null | head -1)"
  node src/screenbox.mjs "$SHOT" --flow "$FLOW" "${BOXARGS[@]+"${BOXARGS[@]}"}" || exit 1
  exec node src/demo.mjs "$SHOT" "$OUT" "${RENDARGS[@]+"${RENDARGS[@]}"}"
fi

if [ "${1:-}" = "wallpapers" ]; then
  shift; exec node src/wallpapers.mjs "$@"
fi

if [ "${1:-}" = "review" ]; then
  shift; SHOT="$(abs "${1:?usage: demokit review <shotDir> <out.mp4> [--fix]}")"; shift
  OUT="$(abs "${1:?usage: demokit review <shotDir> <out.mp4> [--fix]}")"; shift
  exec node src/review.mjs "$SHOT" "$OUT" "$@"
fi

if [ "${1:-}" = "--render-only" ]; then
  shift; SHOT="$(abs "${1:?usage: --render-only <shotDir> <out.mp4>}")"; shift
  OUT="$(abs "${1:?usage: --render-only <shotDir> <out.mp4>}")"; shift
  exec node src/demo.mjs "$SHOT" "$OUT" "$@"
fi

[ -n "$SESSION_OVERRIDE" ] || die "unknown command; run demokit --help"
FLOW="$(abs "${1:?flow JSON required}")"; OUT="$(abs "${2:?output MP4 required}")"; shift 2
[ -f "$FLOW" ] || die "no such flow: $FLOW"
node -e 'JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"))' "$FLOW"
need_playwriter
SHOT="$DEMOKIT_WORK/shot-$(basename "$FLOW" .json)"
node src/playwriter-run.mjs "$SESSION_OVERRIDE" record "$FLOW" "$SHOT"
[ -f "$SHOT/manifest.json" ] || die "capture produced no manifest"
exec node src/demo.mjs "$SHOT" "$OUT" "$@"
